---
import { SITE } from "@/consts";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title=`404 Not Found | ${ SITE.title }`
  description="The page you requested cannot be found!"
  url={new URL(Astro.url.pathname, Astro.site).href}
>
  <h1 class="heading text-center">404</h1>
  <p class="paragraph text-center">The page you requested cannot be found!</p>
</BaseLayout>
