---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBlogCollection } from "@/utils/content";

const pageTitle = "Archive";
const pageDescription = "All notes and blog posts.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const generatedAt = new Date().toISOString();

let rawPosts = await getBlogCollection({ sort: true });

const posts = rawPosts;

type Year = number;
const postsByYear = posts.reduce<Record<Year, typeof posts>>((acc, post) => {
	const year = new Date(post.data.date).getFullYear();
	acc[year] = acc[year] ? [...acc[year], post] : [post];
	return acc;
}, {});
postsByYear;

const years = Object.keys(postsByYear)
	.map((year) => Number(year))
	.sort((a, b) => b - a);

const formatter = new Intl.DateTimeFormat("en-US", {
	day: "2-digit",
	month: "long",
	year: "numeric",
});
---

<BaseLayout title={pageTitle} description={pageDescription} url={canonicalUrl}>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <header class="mb-14">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-3">{pageTitle}</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">{pageDescription}</p>
    </header>
    
    { posts.length === 0 ? (
      <p class="text-gray-600 dark:text-gray-400">
        Пока здесь пусто. Возвращайся позже — новые записи уже в работе.
      </p>
    ) : (
      <div class="space-y-12">
      { years.map((year) => (
      <section>
        <h2 class="text-2xl font-semibold text-gray-800 dark:text-gray-200 mb-6 flex items-center gap-3">
          <span class="text-gray-700 dark:text-gray-300">Year {year}</span>
        </h2>
        <ul class="space-y-4">
        { postsByYear[year].map((post) => (
          <li class="group p-4 rounded-lg border transition dark:border-gray-700 dark:bg-gray-900/40 dark:hover:border-blue-500 dark:hover:bg-gray-900/60">
            <a href={`/blog/${post.id}`}>
              <div class="flex flex-col gap-2">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="text-xl font-medium transition group-hover:text-blue-600 dark:text-gray-100 dark:group-hover:text-blue-400">
                    { post.data.title }
                  </h3>
                  <time class="text-sm dark:text-gray-400" datetime={ formatter.format(new Date(post.data.date)) }>
                    { formatter.format(new Date(post.data.date)) }
                  </time>
                </div>
                { post.data.description && ( <p class="dark:text-gray-400">{post.data.description}</p>) }
                { Array.isArray(post.data.tags) && post.data.tags.length > 0 && (
                  <ul class="flex flex-wrap gap-2 text-sm dark:text-gray-400">
                    { post .data.tags.map((tag) => (<li class="rounded-full border px-3 py-1 dark:border-gray-600">#{tag}</li>)) }
                  </ul>
                )}
              </div>
            </a>
          </li>
        ))}
        </ul>
      </section>
      ))}

      </div>
    )}
  </div>
</BaseLayout>
