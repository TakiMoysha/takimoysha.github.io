---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBlogCollection } from "@/utils/content";

const pageTitle = "Blog";
const pageDescription = "Все записи блога и заметки в одном месте.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const generatedAt = new Date().toISOString();

let rawPosts = await getBlogCollection({ sort: true })

const posts = rawPosts
  ;

const postsByYear = posts.reduce<Record<number, typeof posts>>(
  (acc, post) => {
    const year = new Date(post.data.date).getFullYear();
    acc[year] = acc[year] ? [...acc[year], post] : [post];
    return acc;
  },
  {},
);

const years = Object.keys(postsByYear)
  .map((year) => Number(year))
  .sort((a, b) => b - a);

const formatter = new Intl.DateTimeFormat("ru-RU", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={pageTitle} description={pageDescription} url={canonicalUrl}>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <header class="mb-14">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-3">{pageTitle}</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">{pageDescription}</p>
    </header>

    {posts.length === 0 ? (
      <p class="text-gray-600 dark:text-gray-400">
        Пока здесь пусто. Возвращайся позже — новые записи уже в работе.
      </p>
    ) : (
      <div class="space-y-12">
        {years.map((year) => (
          <section>
            <h2 class="text-2xl font-semibold text-gray-800 dark:text-gray-200 mb-6 flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-900">
                {year}
              </span>
              <span class="text-gray-700 dark:text-gray-300">Записи {year} года</span>
            </h2>

            <ul class="space-y-4">
              {postsByYear[year].map((post) => (
                <li class="group rounded-lg border border-gray-200 bg-white/60 p-5 transition hover:border-blue-400 hover:bg-white dark:border-gray-700 dark:bg-gray-900/40 dark:hover:border-blue-500 dark:hover:bg-gray-900/60">
                  <a href={`/blog/${post.slug}`}> 
                    <div class="flex flex-col gap-2">
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <h3 class="text-xl font-medium text-gray-900 transition group-hover:text-blue-600 dark:text-gray-100 dark:group-hover:text-blue-400">
                          {post.data.title}
                        </h3>
                        <time class="text-sm text-gray-500 dark:text-gray-400" dateTime={post.data.date}>
                          {formatter.format(new Date(post.data.date))}
                        </time>
                      </div>

                      {post.data.description && (
                        <p class="text-gray-600 dark:text-gray-400">
                          {post.data.description}
                        </p>
                      )}

                      {Array.isArray(post.data.tags) && post.data.tags.length > 0 && (
                        <ul class="flex flex-wrap gap-2 text-sm text-gray-600 dark:text-gray-400">
                          {post.data.tags.map((tag) => (
                            <li class="rounded-full border border-gray-300 px-3 py-1 dark:border-gray-600">
                              #{tag}
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(a:focus-visible),
  :global(button:focus-visible) {
    @apply outline-none ring-2 ring-blue-500 ring-offset-2 ring-offset-white rounded dark:ring-blue-400 dark:ring-offset-gray-900;
  }

  :global(body) {
    @apply transition-colors duration-200 bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100;
  }

  section + section {
    @apply border-t border-gray-200 pt-10 dark:border-gray-800;
  }
</style>
