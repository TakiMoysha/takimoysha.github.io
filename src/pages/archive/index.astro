---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBlogCollection } from "@/lib/content";

const pageTitle = "Archive";
const pageDescription = "All notes and blog posts.";

const blogCollection = (await getBlogCollection({ sort: true })).filter((post) => {
	const tags = Array.isArray(post.data.tags) ? post.data.tags : [];
	const isDraft = tags.includes("draft") || post.data.draft === true;
	const isHidden = Boolean(post.data.meta?.hidden);
	return !isDraft && !isHidden;
});

type Year = number;
const postsByYear = blogCollection.reduce<Record<Year, typeof blogCollection>>((acc, post) => {
	const year = post.data.date.getFullYear();
	acc[year] = acc[year] ? [...acc[year], post] : [post];
	return acc;
}, {});

const years = Object.keys(postsByYear)
	.map((year) => Number(year))
	.sort((a, b) => b - a);

const formatter = new Intl.DateTimeFormat("en-US", {
	day: "2-digit",
	month: "long",
	year: "numeric",
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <header class="mb-14">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-3">{pageTitle}</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">{pageDescription}</p>
    </header>

    { JSON.stringify(blogCollection) }

    <div class="space-y-12">
      {years.map((year) => (
        <section>
          <header class="mb-6 border-b border-gray-200 dark:border-gray-700 pb-2">
            <h2 class="text-2xl font-semibold text-gray-800 dark:text-gray-100">{year}</h2>
          </header>

          <div class="space-y-6">
            {postsByYear[year].map((post) => (
              <article class="group border-l-2 border-transparent pl-4 transition hover:border-blue-500">
                <a href={`/blog/${post.slug ?? post.id}`} class="block">
                  <header class="flex flex-wrap items-baseline gap-2 mb-2">
                    <time class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                      {formatter.format(post.data.date)}
                    </time>
                    <h3 class="text-lg font-medium text-blue-600 dark:text-blue-400 group-hover:underline">
                      {post.data.title}
                    </h3>
                  </header>
                  {post.data.description && (
                    <p class="text-gray-700 dark:text-gray-300">
                      {post.data.description}
                    </p>
                  )}
                  {post.data.tags.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-2 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
                      {post.data.tags.map((tag) => (
                        <li class="rounded bg-gray-100 px-2 py-1 dark:bg-gray-800" aria-label={`Tag: ${tag}`}>
                          {tag}
                        </li>
                      ))}
                    </ul>
                  )}
                </a>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

  </div>
</BaseLayout>
