---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { groupArchiveEntries } from "@/lib/content";
import { DEFAULT_LOCALE } from "@/consts";
import type { ArchiveEntryGroup } from "@/lib/content";

import { Debug } from "astro:components";
import { getBlogCollection } from "@/helpers";

const pageTitle = "Archive";
const pageDescription = "All notes, articles and blog posts.";

const blogCollection = await getBlogCollection({ sort: true });

const entryGroups = groupArchiveEntries(blogCollection);

const getRepresentativeEntry = (group: ArchiveEntryGroup) => {
	const locales = Object.keys(group.locales);
	return (
		group.locales[DEFAULT_LOCALE] ??
		group.locales[locales.sort()[0] as keyof typeof group.locales]
	);
};

type Year = number;
const postsByYear = entryGroups.reduce<Record<Year, ArchiveEntryGroup[]>>(
	(acc, group) => {
		const entry = getRepresentativeEntry(group);
		const year = entry.data.date.getFullYear();
		acc[year] = acc[year] ? [...acc[year], group] : [group];
		return acc;
	},
	{},
);

const years = Object.keys(postsByYear)
	.map((year) => Number(year))
	.sort((a, b) => b - a);

const formatter = new Intl.DateTimeFormat("en-US", {
	day: "2-digit",
	month: "long",
	year: "numeric",
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-5xl mx-auto px-4 py-12">

    <Debug blogCollection={blogCollection}/>

    <header class="mb-14">
      <h1 class="text-4xl font-bold text-base-content mb-3">{pageTitle}</h1>
      <p class="text-lg text-neutral-content">{pageDescription}</p>
    </header>

    <div class="space-y-12">
      {years.map((year) => (
        <section>
          <header class="mb-6 border-b border-accent/40 pb-2">
            <h2 class="text-2xl font-semibold text-primary-content">{year}</h2>
          </header>

          <div class="space-y-6">
            {postsByYear[year]
              .map((group) => ({
                group,
                entry: getRepresentativeEntry(group),
              }))
              .map(({ group, entry }) => {
                const locales = Object.keys(group.locales).sort();
                return (
                  <article class="group border-l-2 border-transparent pl-4 transition hover:border-accent">
                    <header class="flex flex-wrap items-baseline gap-2 mb-2">
                      <time class="text-sm text-neutral-content/40 uppercase tracking-wide">
                        {formatter.format(entry.data.date)}
                      </time>
                      <a
                        href={`/archive/${group.slug}`}
                        class="text-lg font-medium text-blue-600 dark:text-blue-400 group-hover:underline"
                      >
                        {entry.data.title}
                      </a>
                    </header>
                    {entry.data.description && (
                      <p class="text-neutral-content">
                        {entry.data.description}
                      </p>
                    )}
                    {entry.data.tags.length > 0 && (
                      <ul class="mt-3 flex flex-wrap gap-2 text-xs uppercase tracking-wide text-secondary-content/40">
                        {entry.data.tags.map((tag) => (
                          <li
                            class="rounded px-2 py-1 bg-base-300"
                            aria-label={`Tag: ${tag}`}
                          >
                            {tag}
                          </li>
                        ))}
                      </ul>
                    )}
                    <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-neutral-content/70">
                      <span class="font-semibold uppercase tracking-wide">Languages:</span>
                      <ul class="flex flex-wrap gap-2">
                        {locales.map((locale) => (
                          <li>
                            <a
                              href={`/archive/${group.slug}?lang=${locale}`}
                              class="px-2 py-1 rounded-full border border-transparent bg-base-200 text-base-content/50  font-semibold uppercase tracking-wide transition hover:border-accent hover:text-accent-content"
                            >
                              {locale}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </article>
                );
              })}
          </div>
        </section>
      ))}
    </div>

  </div>
</BaseLayout>
