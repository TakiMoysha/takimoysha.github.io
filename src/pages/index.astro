---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

import { getBlogCollection } from "@/utils/content";

import { BLOG_COLLECTION_NAME } from "../constants.ts";

let posts = [];

try {
  posts = (await getBlogCollection())
    .filter((post) => {
      const tags = Array.isArray(post.data.tags) ? post.data.tags : [];
      const isDraft = tags.includes("draft") || post.data.draft === true;
      const isHidden = Boolean(post.data.meta?.hidden);
      return !isDraft && !isHidden;
    })
    .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
    .slice(0, 5);
} catch (e) {
  posts = [];
}

const { title, description, url, date } = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  url={`${Astro.site}/${url}`}
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-16 text-center">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">TakiMoysha</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">
        Linux enthusiast • i3wm user • Open Source advocate
      </p>
    </header>

    <section class="mb-16">
      <h2 class="text-2xl font-semibold text-gray-800 dark:text-gray-200 mb-6 pb-2 border-b border-gray-200 dark:border-gray-700">
        Latest Posts
      </h2>
      <div class="space-y-8">
        {posts.map((post) => (
          <article class="group">
            <a href={`/blog/${post.slug}`} class="block">
              <h3 class="text-xl font-medium text-blue-600 dark:text-blue-400 group-hover:underline mb-1">
                {post.data.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm mb-2">
                {new Date(post.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <p class="text-gray-700 dark:text-gray-300">
                {post.data.description}
              </p>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <div class="bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 p-6 rounded-lg">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-4">About Me</h2>
        <p class="text-gray-700 dark:text-gray-300 mb-4">
          Software developer passionate about open source, Linux, and efficient workflows. 
          I use Arch btw, with i3wm for a minimal, keyboard-driven experience.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 text-sm bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full">
            Linux
          </span>
          <span class="px-3 py-1 text-sm bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full">
            i3wm
          </span>
          <span class="px-3 py-1 text-sm bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded-full">
            Utilitarianism
          </span>
          <span class="px-3 py-1 text-sm bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded-full">
            Open Source
          </span>
        </div>
      </div>

      <div class="bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 p-6 rounded-lg">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-4">Quick Links</h2>
        <ul class="space-y-3">
          <li>
            <a href="/blog" class="flex items-center text-blue-600 dark:text-blue-400 hover:underline">
              <span class="mr-2">📝</span> All Blog Posts
            </a>
          </li>
          <li>
            <a href="https://github.com/TakiMoysha" target="_blank" rel="noopener noreferrer" class="flex items-center text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-300">
              <span class="mr-2">💻</span> GitHub
            </a>
          </li>
          <li>
            <a href="https://archlinux.org/" target="_blank" rel="noopener noreferrer" class="flex items-center text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-300">
              <span class="mr-2">🐧</span> Arch Linux
            </a>
          </li>
          <li>
            <a href="https://i3wm.org/" target="_blank" rel="noopener noreferrer" class="flex items-center text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-300">
              <span class="mr-2">⌨️</span> i3 Window Manager
            </a>
          </li>
        </ul>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";

  /* Smooth scrolling and focus styles */
  :global(html) {
    scroll-behavior: smooth;
  }

  /* Focus styles for keyboard navigation */
  :global(a:focus-visible),
  :global(button:focus-visible) {
    @apply outline-none ring-2 ring-blue-500 ring-offset-2 ring-offset-white rounded dark:ring-blue-400 dark:ring-offset-gray-900;
  }

  /* Dark mode transitions */
  :global(body) {
    @apply transition-colors duration-200 bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100;
  }
</style>
