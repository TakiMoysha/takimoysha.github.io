---
import LinkButton from "./LinkButton.astro";

export interface Props {
  href: string;
  icon: string;
  linkTitle: string;
  centered?: boolean;
}

const { centered = false, href, icon, linkTitle } = Astro.props;
---

<div class:list={["flex-wrap justify-center gap-1", { flex: centered }]}>
  <LinkButton href={href} class="p-2 hover:rotate-6 sm:p-1" title={linkTitle}>
    <!-- <social.icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" /> -->
    <span class="sr-only">{linkTitle}</span>
  </LinkButton>
</div>
