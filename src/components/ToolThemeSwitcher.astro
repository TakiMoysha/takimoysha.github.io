---
const availableThemes = "nord,dark";
---

<script is:inline>
if (localStorage.getItem("theme") === null) {
  document.documentElement.setAttribute("data-theme", "dark");
} else {
  document.documentElement.setAttribute("data-theme", localStorage.getItem("theme"));
}
</script>

<script>
import { themeChange } from "theme-change";
themeChange();
</script>

<div>
	<div class="inline-block w-10">
		<span
			data-toggle-theme={availableThemes}
			data-act-class="pl-4"
			class="border rounded-full border-accent flex items-center cursor-pointer w-10 transition-all duration-300"
		>
			<span class="rounded-full w-3 h-3 m-1 transition-transform">
				<i class="fa-solid fa-moon text-accent"/>
				<i class="fa-solid fa-sun text-accent"/>
			</span>
		</span>
	</div>
</div>
