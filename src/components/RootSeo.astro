---
import { SITE } from "@/consts";

export interface Props {
  title: string;
  lang?: "en" | "ru";
  description?: string;
  url?: string;
  author?: string;
  canonicalURL?: string;
  imageURL?: string;
}

const { author } = Astro.props;

// rewrite semantic core
const {
  lang = "en",
  title = SITE.title,
  description = SITE.description || "",
  canonicalURL = Astro.url
} = Astro.props;

const ld_json = JSON.stringify(
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": author,
    "url": Astro.site,
    "sameAs": [
      "https://github.com/takimoysha",
      "https://linkedin.com/in/takimoysha",
    ],
    "potentialAction": {
      "@type": "SearchAction",
      "target": Astro.site + "/blog/search?q={search_string}",
      "query-input": "required query=search_string"
    }
  }
)
---

<!-- general -->
<html lang={lang} />
<link rel="canonical" href={canonicalURL} />
<title>{title}</title>
<meta name="description" content={description} />

<!-- OpenGraph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:local" content={lang} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="TakiMoysha" />
{
  Astro.props.imageURL && (
    <meta property="og:image" content={Astro.props.imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  )
}

<!-- Twitter / X -->
{Astro.props.imageURL && (
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:image" content={Astro.props.imageURL} />
)}
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />


{lang === 'en' && (
  <link rel="alternate" hreflang="ru" href={Astro.site + "/ru/"} />
)}
{lang === 'ru' && (
  <link rel="alternate" hreflang="en" href={Astro.site + "/en/"} />
)}

<!-- TODO: test sitemap -->
<link rel="sitemap" href="/sitemap.xml" />

<!-- TODO: test links -->
<link
  rel="alternate"
  type="application/rss+xml"
  title="TakiMoysha RSS Feed"
  href={new URL("feed.xml", Astro.site)}
/>

<!-- third-party metadata -->
<meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
<meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />

<!-- https://schema.org/docs/gs.html -->
<script is:inline type="application/ld+json" set:html={ld_json}></script>
