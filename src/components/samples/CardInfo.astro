---
interface Props {
  title: string;
  description: string;
  icon: string;
}
const { title, description, icon } = Astro.props;
---

<div class="rounded-xl p-6 m-2 shadow-md hover:shadow-lg transition bg-gray-600 shadow-neutral-800">
  <div class="flex intems-start gap-x-3 mb-2">
    <span class="flex items-center">
      <div class="flex-none w-6 h-[1hl] text-accent" set:html={icon}></div>
    </span>
    <h4 class="text-xl font-semibold">{ title }</h4>
  </div>

  <p class="text-neutral-100">{ description }</p>
</div>
