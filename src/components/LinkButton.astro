---
export interface Props {
	id?: string;
	href: string;
	title?: string;
	class?: string;
	disabled?: boolean;
}

const { id, href, title, class: klass = "", disabled = false } = Astro.props;
---

{
  disabled ? (
    <span
      id={id}
      class:list={["group inline-block", klass]}
      title={title}
      aria-disabled={disabled}
    >
      <slot />
    </span>
  ) : (
    <a
      id={id}
      {href}
      class:list={["group inline-block text-base-content hover:text-accent", klass]}
      title={title}
    >
      <slot />
    </a>
  )
}

