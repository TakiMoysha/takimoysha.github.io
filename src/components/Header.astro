---
import Hr from "./Hr.astro";
import IconX from "@/assets/icons/SocialsX.svg";
import IconMoon from "@/assets/icons/Moon.svg";
import IconSearch from "@/assets/icons/Search.svg";
import IconRSS from "@/assets/icons/RSS.svg";
import IconArchive from "@/assets/icons/Archive.svg";
import IconSunHigh from "@/assets/icons/SunHigh.svg";
import IconMenuDeep from "@/assets/icons/MenuDeep.svg";
import LinkButton from "./LinkButton.astro";

const SITE = {
  title: "TakiMoysha",
  description: "Blog, notes and reports about development.",
  defaultLanguage: "en-us",
}

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    role="navigation"
    aria-label="Skip to main content"
    aria-hidden="true"
    class="absolute start-8 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    Skip to content
  </a>

  <nav class="flex items-center justify-between" aria-label="global navigation" >

  </nav

  <Hr/>
</header>
