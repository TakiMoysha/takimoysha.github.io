---
// TODO: required refactoring, support for light theme
import { SITE } from "@/consts";
import BaseLayout from "@/layouts/BaseLayout.astro";

export interface Props {
	code: "404" | "500" | "work-in-progress";
}

const ErrorMap = new Map<string, { text: string; description: string }>();

ErrorMap.set("404", {
	text: "404 Not Found",
	description: "Page not found, check the URL.",
});
ErrorMap.set("500", {
	text: "500 Internal Server Error",
	description: "Something wint wrong on our end.",
});
ErrorMap.set("work-in-progress", {
  text: "Work In Progress",
  description: "This page is under development.",
});

const defaultError = {
	text: "Unexpected Error",
	description: "I don't know what heppens ¯\\_(ツ)_/¯",
};

const { code = "500" } = Astro.props;
const error = ErrorMap.get(code) || defaultError;
---

<BaseLayout
  title=`${error.text} | ${ SITE.title }`
  description=`${error.description}`
>
  <div class="flex items-center justify-center p-4">
    <div class="max-w-4xl w-full mx-auto">
      <div class="glitch-container relative">
        <!-- <div class="glitch-lines"></div> -->

        <div class="error-box ">
          <h1 class="glitch text-center text-6xl font-bold font-digital text-shadow-md" data-text=`${error.text}`>{error.text}</h1>
        </div>
        
        <div class="mt-8 ">
          <p class="text-center text-xl md:text-2xl text-neutral-content mb-8 font-digital text-shadow-md">{error.description}</p>
        </div>
        
        <div class="bg-gray-900 p-4 rounded-lg border border-gray-800 overflow-hidden relative">
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>
          <code class="relative z-10 block text-green-400 font-digital text-sm overflow-x-auto">
            <span class="rerror-code text-purple-400">if</span> (<span class="text-blue-400">!</span><span class="text-white">router</span>.<span class="text-yellow-400">get</span><span class="text-green-200">('{Astro.url.pathname}'</span>)) &lbrace;
            <br/>&nbsp;&nbsp;<span class="text-red-400">console</span>.<span class="text-yellow-400">error</span>(<span class="text-green-200">'{error.text}'</span>);
            <br/>&nbsp;&nbsp;<span class="text-purple-400">throw new </span><span class="text-blue-400">Error</span>(<span class="text-green-200">'The page you are looking for does not exist'</span>);
            <br/>&rbrace;
          </code>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-box {
    -webkit-animation: noise-1 .2s linear infinite;
            animation: noise-1 .2s linear infinite;
  }
  
  /* Glitch Effect */
  .glitch {
    position: relative;
    color: #fff;
    letter-spacing: 0.5px;
  }
  
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    width: 100%;
    height: 100%;
    background: transparent;
  }
  
  .glitch::before {
    left: 2px;
    text-shadow: -2px 0 #ff00ff;
    clip: rect(44px, 450px, 56px, 0);
    animation: glitch-text-gradient 5s infinite ease-in-out ;
  }
  
  .glitch::after {
    left: -2px;
    text-shadow: 2px 0 #00ffff;
    clip: rect(44px, 450px, 56px, 0);
    animation: glitch-text-itch 5s infinite linear alternate-reverse;
  }
  
  @keyframes glitch-text-gradient {
    0% { clip: rect(31px, 9999px, 94px, 0); }
    10% { clip: rect(112px, 9999px, 76px, 0); }
    20% { clip: rect(85px, 9999px, 77px, 0); }
    30% { clip: rect(27px, 9999px, 97px, 0); }
    40% { clip: rect(64px, 9999px, 98px, 0); }
    50% { clip: rect(90px, 9999px, 91px, 0); }
    60% { clip: rect(111px, 9999px, 114px, 0); }
    70% { clip: rect(23px, 9999px, 92px, 0); }
    80% { clip: rect(64px, 9999px, 98px, 0); }
    90% { clip: rect(40px, 9999px, 73px, 0); }
    100% { clip: rect(62px, 9999px, 93px, 0); }
  }
  
  @keyframes glitch-text-itch {
    0% { clip: rect(65px, 9999px, 119px, 0); }
    10% { clip: rect(52px, 9999px, 74px, 0); }
    20% { clip: rect(86px, 9999px, 85px, 0); }
    30% { clip: rect(95px, 9999px, 91px, 0); }
    40% { clip: rect(120px, 9999px, 74px, 0); }
    50% { clip: rect(71px, 9999px, 103px, 0); }
    60% { clip: rect(84px, 9999px, 67px, 0); }
    70% { clip: rect(60px, 9999px, 99px, 0); }
    80% { clip: rect(98px, 9999px, 114px, 0); }
    90% { clip: rect(46px, 9999px, 65px, 0); }
    100% { clip: rect(30px, 9999px, 92px, 0); }
  }

  @-webkit-keyframes noise-1 {
    /* 0%, 20%, 40%, 60%, 70%, 90% {opacity: 0;} */
    /* 10% {opacity: .1;} */
    /* 50% {opacity: .5; left: -6px;} */
    /* 80% {opacity: .3;} */
    /* 100% {opacity: .6; left: 2px;} */
  }
  @keyframes noise-1 {
    /* 0%, 20%, 40%, 60%, 70%, 90% {opacity: 0;} */
    /* 10% {opacity: .1;} */
    /* 50% {opacity: .5; left: -6px;} */
    /* 80% {opacity: .3;} */
    /* 100% {opacity: .6; left: 2px;} */
  }

  
  /* Container styles */
  .glitch-container {
    position: relative;
    max-width: 100%;
    padding: 1rem;
  }
  
  .glitch-container::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      ,
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 255, 255, 0.1) 50%
    );
    background-size: 100% 4px;
    animation: scanline 1s linear infinite;
    pointer-events: none;
    z-index: 10;
  }
  
  @keyframes scanline {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }
  
  /* glitch animated lines */
  .glitch-lines {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 255, 255, 0.1) 50%,
      transparent 100%
    );
    background-size: 30% 12px;
    animation: glitch-line 1.2s infinite alternate;
    opacity: 0.4;
    pointer-events: none;
    z-index: -1;
  }
  
  @keyframes glitch-line {
    0% { transform: translateY(40%); }
    100% { transform: translateY(-40%); }
  }
  
  /* code block styling */
  .error-code {
    font-family: 'Share Tech Mono', monospace;
  }
  
  /* Cursor Animation */
  .error-code::after {
    content: '|';
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    color: #00ff00;
    animation: blink 1s step-end infinite;
  }
  
  @keyframes blink {
    from, to { opacity: 1; }
    50% { opacity: 0; }
  }

