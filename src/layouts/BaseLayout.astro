---
import Footer from "@/components/RootFooter.astro";
import Header from "@/components/RootHeader.astro";
import Seo from "@/components/RootSeo.astro";
import "@/assets/styles/global.css";
import "@/assets/styles/resources.css";

interface Props {
	title: string;
	description: string | undefined;
	url?: string;
}

const {
	title,
	description,
	url = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index, follow" />
		<meta name="description" property="og:description" content={description} />

		<link rel="icon" type="image/svg+xml" href="/favicon.png" />

    <Seo {title} {description} {url} />
	</head>

  <body class="body-margin flex min-h-screen flex-col">
		<Header />
		<main id="main-content" class="main-margin relative z-1 flex-1">
		  <slot />
		</main>
		<Footer />
	</body>
</html>
