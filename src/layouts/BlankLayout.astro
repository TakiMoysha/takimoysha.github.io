---


<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="UTF-8" />
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index, follow" />
		<title>{title}</title>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>

  <script is:inline>
    const THEME_KEY = 'theme';

    const button = document.getElementById('theme-toggle-btn');
    if (!button) console.warn('Theme toggle button not found');

    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    const applyTheme = (theme) => {
      const isDark = theme === 'dark';
      document.documentElement.classList.toggle('dark', isDark);
      document.documentElement.classList.toggle('light', !isDark);
      if (button) button.textContent = isDark ? '🌜' : '🌞';
      localStorage.setItem(THEME_KEY, theme);
    };

    const themeProxy = new Proxy(
      { value: localStorage.getItem(THEME_KEY) || (prefersDark ? 'dark' : 'light') },
      {
        set(target, prop, value) {
          target[prop] = value;
          applyTheme(value);
          return true;
        },
      }
    );

    document.addEventListener("DOMContentLoaded", () => {
      applyTheme(themeProxy.value);
      document.getElementById('theme-toggle-btn')?.addEventListener('click', () => {
        themeProxy.value = themeProxy.value === 'dark' ? 'light' : 'dark';
      });
    })
  </script>


  <body class="body-margin flex min-h-screen flex-col">
		<header class="bg-white dark:bg-neutral-800">
		  <div class="flex items-center justify-between max-w-6xl mx-auto p-4">
		    <h1 class="text-2xl font-bold text-brand">Blank Layout</h1>
		    <nav class="hidden md:flex space-x-6">
		      <a href="#" class="text-onlight-text hover:text-brand transition">Home</a>
		      <a href="#" class="text-onlight-text hover:text-brand transition">Projects</a>
		      <a href="#" class="text-onlight-text hover:text-brand transition">Links</a>
		      <a href="#" class="text-onlight-text hover:text-brand transition">About</a>

          <button id="theme-toggle-btn" class="ml-4 rounded-full text-neutral-800 dark:text-neutral-200">loading...</button>
		    </nav>
		  </div>
		</header>

		<main id="main-content" class="scheme-light-dark dark:scheme-dark">
		  <!-- hero section -->
  	  <section class="py-8 bg-gradient-to-r from-indigo-500 from-10% via-sky-500 via-30% to-emerald-500 to-90%">
  	    <div class="container mx-auto px-6 text-center">
          <h2 class="text-4xl md:text-6xl font-bold text-onlight mb-6">
            Welcome to <span class="text-accent font-mono">Simple Landing Layout</span>
          </h2>
          <p class="text-lg md:text-xl text-zinc-700 max-w-3xl mx-auto mb-8">Simple langind for see, how it look.</p>
          <div class="pb-4">
            <button class="bg-accent-500 hover:bg-accent-800 text-primary font-semibold py-3 px-8 rounded-lg shadow-lg transform hover:scale-105 transition">Left</button>
            <button class="bg-accent-500 hover:bg-accent-800 text-primary font-semibold py-3 px-8 rounded-lg shadow-lg transform hover:scale-105 transition">Right</button>
          </div>
  	    </div>
  	  </section>

      <!-- grid section -->
  	  <section class="py-16 bg-cyan-100 dark:bg-gray-700">
  	    <div class="container mx-auto px-6">
  	      <h3 class="text-3xl font-bold text-center text-neutral-300 mb-12">Wisdom</h3>
  	      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

            <!-- cards -->
            {
              properties.map((i) => (
                <CardInfo title={i.title} description={i.description} icon={i.icon}/>
              ))
            }
          </div>
        </div>
  	  </section>

  	  <!-- testimonials -->
      <section class="relative isolate overflow-hidden bg-gray-900 px-6 py-24 sm:py-32 lg:px-8">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(45rem_50rem_at_top,var(--color-indigo-500),transparent)] opacity-10"></div>
        <div class="absolute inset-y-0 right-1/2 -z-10 mr-16 w-[200%] origin-bottom-left skew-x-[-30deg] bg-gray-900 shadow-xl ring-1 shadow-indigo-500/5 ring-white/5 sm:mr-28 lg:mr-0 xl:mr-16 xl:origin-center"></div>

        <div class="container mx-auto px-6">
          <h2 class="text-3xl md:text-4xl font-bold text-center text-shadow-lg mb-12">Testimonials</h2>

          <div></div>
        </div>
  	  </section>
  	</main>
	</body>
</html>
