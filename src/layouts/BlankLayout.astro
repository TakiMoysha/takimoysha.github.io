---
import "@/assets/styles/global.css";

import CardInfo from "../components/samples/CardInfo.astro";

interface Props {
	title?: string;
}

const url = new URL(Astro.url.pathname, Astro.site).href
const { title = "Blank Page | TakiMoysha" } = Astro.props;

const icon_0 = `
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
  </svg>
`;
const icon_1 = `
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-secondary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
  </svg>
`
const icon_2 = `
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
  </svg>
`

const items = [
  {
    "title": "Robust",
    "description": "Po, the day you were chosen as Dragon Warrior was the worst day of my life. By far. Nothing else came close.",
    "icon": icon_0,
  },
  {
    "title": "Efficient",
    "description": "Honestly, I didn't really know what I was doing.",
    "icon": icon_1,
  },
  {
    "title": "Intuitive",
    "description": "Your enemy can't guess your strategy if you don't have any.",
    "icon": icon_2,
  }
];
---

<script>
  document.getElementById("theme-toggle").addEventListener("click", () => {
    const _btn = document.getElementById("theme-toggle");
    document.documentElement.classList.toggle("dark")
    const isDark = document.documentElement.classList.contains("dark")
    if (isDark) {
      _btn.innerText = '🌜 Dark'
    } else {
      _btn.innerText = '🌞 Light';
    }
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
  if (localStorage.getItem("theme") === "dark") {
    document.documentElement.classList.add("dark");
  }
</script>

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="UTF-8" />
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index, follow" />
		<title>{title}</title>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      const saved = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.add(saved || (prefersDark ? "dark" : "light"));
    </script>

	</head>

  <body class="body-margin flex min-h-screen flex-col">
		<header class="bg-white dark:bg-neutral-800 shadow-sm border-b border-neutral-200">
		  <div class="flex items-center justify-between max-w-6xl mx-auto p-4">
		    <h1 class="text-2xl font-bold text-sunset-orange-900">Blank Layout</h1>
		    <nav class="hidden md:flex space-x-6">
		      <a href="#" class="text-gray-300 hover:text-gray-500 transition">Home</a>
		      <a href="#" class="text-gray-300 hover:text-gray-500 transition">Projects</a>
		      <a href="#" class="text-gray-300 hover:text-gray-500 transition">Links</a>
		      <a href="#" class="text-gray-300 hover:text-gray-500 transition">About</a>


          <button id="theme-toggle" class="ml-4 rounded-full text-neutral-800 dark:text-neutral-200">Theme</button>

		    </nav>
		  </div>
		</header>

		<main id="main-content" class="scheme-light-dark dark:scheme-dark">
		  <!-- hero section -->
  	  <section class="py-8 bg-gradient-to-r from-indigo-500 from-10% via-sky-500 via-30% to-emerald-500 to-90%">
  	    <div class="container mx-auto px-6 text-center">
          <h2 class="text-4xl md:text-6xl font-bold text-zinc-900 mb-6">
            Welcome to <span class="text-primary-600">Simple Landing Layout</span>
          </h2>
          <p class="text-lg md:text-xl text-zinc-700 max-w-3xl mx-auto mb-8">Simple langind for see, how it look.</p>
          <div class="pb-4">
            <button class="bg-accent-500 hover:bg-accent-800 text-white font-semibold py-3 px-8 rounded-lg shadow-lg transform hover:scale-105 transition">Left</button>
            <button class="bg-accent-500 hover:bg-accent-800 text-white font-semibold py-3 px-8 rounded-lg shadow-lg transform hover:scale-105 transition">Right</button>
          </div>
  	    </div>
  	  </section>

      <!-- grid section -->
  	  <section class="py-16 bg-gray-700">
  	    <div class="container mx-auto px-6">
  	      <h3 class="text-3xl font-bold text-center text-neutral-300 mb-12">The Worlds, hmmm</h3>
  	      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

            <!-- cards -->
            {
              items.map((item) => (
                <CardInfo title={item.title} description={item.description} icon={item.icon}/>
              ))
            }
          </div>
        </div>
  	  </section>

  	  <!-- testimonials -->
      <section class="relative isolate overflow-hidden bg-gray-900 px-6 py-24 sm:py-32 lg:px-8">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(45rem_50rem_at_top,var(--color-indigo-500),transparent)] opacity-10"></div>
        <div class="absolute inset-y-0 right-1/2 -z-10 mr-16 w-[200%] origin-bottom-left skew-x-[-30deg] bg-gray-900 shadow-xl ring-1 shadow-indigo-500/5 ring-white/5 sm:mr-28 lg:mr-0 xl:mr-16 xl:origin-center"></div>

        <div class="@container"></div>
  	  </section>
  	</main>
	</body>
</html>
