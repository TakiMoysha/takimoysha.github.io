---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBlogCollection } from "@/lib/content";

const posts = await getBlogCollection({ sort: true }).then((post) => post.slice(0, 5));

const { title, description, url, date } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  url={`${Astro.site}/${url}`}
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 pb-2 border-b">Latest Posts</h2>
      <div class="space-y-8">
        {posts.map((post) => (
          <article class="group">
            <a href={`/blog/${post.id}`} class="block">
              <h3 class="text-xl font-medium text-blue-600 dark:text-blue-400 group-hover:underline mb-1">
                {post.data.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm mb-2">
                {new Date(post.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <p class="text-gray-700 dark:text-gray-300">
                {post.data.description}
              </p>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
